#!/usr/bin/env bash
set -euo pipefail

EXIT_USAGE=2
EXIT_RUNTIME=3

usage() {
  cat <<'USAGE'
sigmap - Signature Map helper (plugin)

Usage:
  sigmap refresh [--root <repo_root>] [--map <signatures_json>] [--generator <path>]
  sigmap ensure  [--root <repo_root>] [--map <signatures_json>] [--generator <path>]

  sigmap name <Symbol> [--kind any|type|callable] [--file <path_prefix> ...] [--limit N]
             [--json] [--strict-empty] [--no-refresh]
             [--root <repo_root>] [--map <signatures_json>] [--generator <path>]

  sigmap search <regex> [--kind any|type|callable] [--field path|signature|comment|all]
               [--file <path_prefix> ...] [--limit N] [--icase]
               [--json] [--strict-empty] [--no-refresh]
               [--root <repo_root>] [--map <signatures_json>] [--generator <path>]

  sigmap show <path::symbol> [--json] [--strict-empty] [--no-refresh]
             [--root <repo_root>] [--map <signatures_json>] [--generator <path>]

  sigmap open [<path::symbol>] [--entry <path::symbol> ...] [--loc <relative/path:line[-line]> ...]
             [--context N] [--json] [--no-refresh]
             [--root <repo_root>] [--map <signatures_json>] [--generator <path>]

  sigmap batch-open [--entry <path::symbol> ...] [--entries-file <file> ...] [--loc <relative/path:line[-line]> ...]
                   [--context N] [--json] [--no-refresh]
                   [--root <repo_root>] [--map <signatures_json>] [--generator <path>]

  sigmap doctor [--root <repo_root>] [--map <signatures_json>] [--generator <path>] [--json]

Exit codes:
  0 - success (including empty query result unless --strict-empty)
  1 - unresolved selector for open/batch-open OR strict-empty result
  2 - usage/arguments error
  3 - runtime error (io/json/generator/regex/internal)
USAGE
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PYTHON_BIN="${PYTHON_BIN:-}"
if [[ -z "${PYTHON_BIN}" ]]; then
  if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
  else
    PYTHON_BIN="python"
  fi
fi

ROOT_DIR=""
SIG_FILE=""
GENERATOR=""

die_usage() {
  echo "ERROR: $*" >&2
  usage >&2
  exit "${EXIT_USAGE}"
}

die_runtime() {
  echo "ERROR: $*" >&2
  exit "${EXIT_RUNTIME}"
}

nl_join() {
  local out=""
  local item
  for item in "$@"; do
    out+="${item}"$'\n'
  done
  printf '%s' "${out}"
}

resolve_context() {
  local root_override="${1:-}"
  local map_override="${2:-}"
  local generator_override="${3:-}"
  local root_candidate=""
  local map_candidate=""
  local generator_candidate=""

  if [[ -n "${root_override}" ]]; then
    root_candidate="${root_override}"
  elif [[ -n "${SIGMAP_ROOT:-}" ]]; then
    root_candidate="${SIGMAP_ROOT}"
  elif git -C "${PWD}" rev-parse --show-toplevel >/dev/null 2>&1; then
    root_candidate="$(git -C "${PWD}" rev-parse --show-toplevel)"
  else
    root_candidate="${PWD}"
  fi

  if [[ ! -d "${root_candidate}" ]]; then
    die_runtime "repo root does not exist: ${root_candidate}"
  fi

  ROOT_DIR="$(cd "${root_candidate}" && pwd)"

  if [[ -n "${map_override}" ]]; then
    map_candidate="${map_override}"
  elif [[ -n "${SIGMAP_FILE:-}" ]]; then
    map_candidate="${SIGMAP_FILE}"
  else
    map_candidate="${ROOT_DIR}/signatures.json"
  fi

  if [[ "${map_candidate}" != /* ]]; then
    map_candidate="${ROOT_DIR}/${map_candidate}"
  fi
  SIG_FILE="${map_candidate}"

  if [[ -n "${generator_override}" ]]; then
    generator_candidate="${generator_override}"
  elif [[ -n "${SIGMAP_GENERATOR:-}" ]]; then
    generator_candidate="${SIGMAP_GENERATOR}"
  else
    generator_candidate="${SCRIPT_DIR}/generate-signatures.sh"
  fi

  if [[ "${generator_candidate}" != /* ]]; then
    generator_candidate="${PWD}/${generator_candidate}"
  fi
  GENERATOR="${generator_candidate}"
}

validate_json() {
  "${PYTHON_BIN}" - "$1" <<'PY'
import json
import sys

path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
    if not isinstance(data, list):
        raise ValueError("JSON root must be an array")
except Exception:
    sys.exit(1)
PY
}

refresh_map() {
  if [[ ! -x "${GENERATOR}" ]]; then
    die_runtime "signature generator not found or not executable: ${GENERATOR}"
  fi

  mkdir -p "$(dirname "${SIG_FILE}")"
  if ! "${GENERATOR}" --root "${ROOT_DIR}" --out "${SIG_FILE}" >/dev/null; then
    die_runtime "generator execution failed: ${GENERATOR}"
  fi

  if ! validate_json "${SIG_FILE}"; then
    die_runtime "generated map is invalid JSON: ${SIG_FILE}"
  fi
}

ensure_map_present() {
  if [[ ! -f "${SIG_FILE}" ]]; then
    die_runtime "map file not found: ${SIG_FILE}"
  fi
  if ! validate_json "${SIG_FILE}"; then
    die_runtime "map file is invalid JSON: ${SIG_FILE}"
  fi
}

prepare_map() {
  local no_refresh="${1:-0}"
  if [[ "${no_refresh}" == "1" ]]; then
    ensure_map_present
  else
    refresh_map
  fi
}

run_query() {
  "${PYTHON_BIN}" - "${SIG_FILE}" "$@" <<'PY'
import json
import os
import re
import sys
from typing import Any, Dict, List

sig_file = sys.argv[1]
cmd = sys.argv[2]


def emit_error(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(3)


def load_entries(path: str) -> List[Dict[str, Any]]:
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as exc:
        emit_error(f"failed to read map JSON: {exc}")
    if not isinstance(data, list):
        emit_error("signatures.json must be a JSON array")
    return data


def normalized_kind(entry: Dict[str, Any]) -> str:
    k = str(entry.get("kind", "callable") or "callable").strip().lower()
    if k not in {"type", "callable"}:
        return "callable"
    return k


def print_entries(entries: List[Dict[str, Any]]) -> None:
    for e in entries:
        path = e.get("path", "")
        line = e.get("line", "")
        sig = e.get("signature", "")
        comment = e.get("comment", "")
        kind = normalized_kind(e)
        print(f"{path} @L{line} [{kind}]")
        if sig:
            print(sig)
        if comment:
            print("COMMENT:")
            print(comment)
        print("---")


entries = load_entries(sig_file)
prefixes = [p for p in os.environ.get("FILE_PREFIXES", "").splitlines() if p]
kind_filter = os.environ.get("KIND_FILTER", "any").strip().lower() or "any"
if kind_filter not in {"any", "type", "callable"}:
    emit_error(f"invalid kind filter: {kind_filter}")

limit = int(os.environ.get("LIMIT", "20"))
as_json = os.environ.get("AS_JSON", "0") == "1"
strict_empty = os.environ.get("STRICT_EMPTY", "0") == "1"


def by_prefix(path: str) -> bool:
    if not prefixes:
        return True
    return any(path.startswith(prefix) for prefix in prefixes)


def by_kind(entry: Dict[str, Any]) -> bool:
    if kind_filter == "any":
        return True
    return normalized_kind(entry) == kind_filter


query_meta: Dict[str, Any] = {
    "command": cmd,
    "kind": kind_filter,
    "limit": limit,
    "strict_empty": strict_empty,
    "prefixes": prefixes,
}

if cmd == "name":
    symbol = sys.argv[3]
    query_meta["symbol"] = symbol
    result = [
        e for e in entries
        if str(e.get("path", "")).endswith("::" + symbol)
        and by_prefix(str(e.get("path", "")))
        and by_kind(e)
    ]
elif cmd == "search":
    pattern = sys.argv[3]
    field = os.environ.get("FIELD", "all")
    icase = os.environ.get("ICASE", "0") == "1"
    query_meta.update({"pattern": pattern, "field": field, "icase": icase})

    flags = re.IGNORECASE if icase else 0
    try:
        rx = re.compile(pattern, flags)
    except re.error as exc:
        emit_error(f"invalid regex: {exc}")

    def haystacks(entry: Dict[str, Any]) -> List[str]:
        if field == "path":
            return [str(entry.get("path", ""))]
        if field == "signature":
            return [str(entry.get("signature", ""))]
        if field == "comment":
            return [str(entry.get("comment", ""))]
        return [
            str(entry.get("path", "")),
            str(entry.get("signature", "")),
            str(entry.get("comment", "")),
        ]

    result = []
    for entry in entries:
        path = str(entry.get("path", ""))
        if not by_prefix(path) or not by_kind(entry):
            continue
        if any(rx.search(h or "") for h in haystacks(entry)):
            result.append(entry)
elif cmd == "show":
    key = sys.argv[3]
    query_meta["path_symbol"] = key
    result = [e for e in entries if str(e.get("path", "")) == key]
else:
    emit_error(f"unknown query command: {cmd}")

result.sort(key=lambda e: (str(e.get("path", "")), int(e.get("line", 0) or 0)))
if limit > 0:
    result = result[:limit]

status = "ok" if result else "empty"

if as_json:
    payload = {
        "status": status,
        "result_count": len(result),
        "query": query_meta,
        "results": result,
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2))
else:
    print_entries(result)

if not result and strict_empty:
    sys.exit(1)
sys.exit(0)
PY
}

run_open() {
  "${PYTHON_BIN}" - "${SIG_FILE}" "${ROOT_DIR}" <<'PY'
import json
import os
import re
import sys
from typing import Any, Dict, List

sig_file = sys.argv[1]
root_dir = os.path.abspath(sys.argv[2])
entries_raw = [x for x in os.environ.get("ENTRIES", "").splitlines() if x]
locs_raw = [x for x in os.environ.get("LOCS", "").splitlines() if x]
ctx = int(os.environ.get("CTX", "40"))
as_json = os.environ.get("AS_JSON", "0") == "1"


def emit_runtime(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(3)


try:
    with open(sig_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as exc:
    emit_runtime(f"failed to read map JSON: {exc}")

if not isinstance(data, list):
    emit_runtime("signatures.json must be a JSON array")

index: Dict[str, List[Dict[str, Any]]] = {}
for item in data:
    key = str(item.get("path", ""))
    index.setdefault(key, []).append(item)
for key in index:
    index[key].sort(key=lambda e: int(e.get("line", 0) or 0))


def to_rel(path: str) -> str:
    abs_path = os.path.abspath(path)
    try:
        rel = os.path.relpath(abs_path, root_dir)
    except ValueError:
        return abs_path
    if rel.startswith(".."):
        return abs_path
    return rel


def read_file(path: str) -> List[str]:
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        return f.readlines()


def render_snippet(lines: List[str], start: int, end: int, hi_start: int, hi_end: int) -> str:
    chunk = []
    for i in range(start, min(end, len(lines)) + 1):
        prefix = ">>" if hi_start <= i <= hi_end else "  "
        chunk.append(f"{prefix}{i:5d} | {lines[i - 1].rstrip()}")
    return "\n".join(chunk)


results: List[Dict[str, Any]] = []
errors: List[str] = []

for selector in entries_raw:
    match = index.get(selector)
    if not match:
        errors.append(f"entry not found in map: {selector}")
        continue

    item = match[0]
    mapped_path = str(item.get("path", "")).split("::", 1)[0]
    abs_file = mapped_path if os.path.isabs(mapped_path) else os.path.join(root_dir, mapped_path)
    if not os.path.exists(abs_file):
        errors.append(f"file missing for map entry {selector}: {abs_file}")
        continue

    try:
        line = int(item.get("line", 1) or 1)
    except Exception:
        line = 1

    lines = read_file(abs_file)
    hi_start = max(1, line)
    hi_end = hi_start
    snippet_start = max(1, hi_start - ctx)
    snippet_end = hi_end + ctx

    results.append(
        {
            "selector": f"entry:{selector}",
            "resolved": selector,
            "file": to_rel(abs_file),
            "absolute_file": os.path.abspath(abs_file),
            "line": hi_start,
            "range": {"start": hi_start, "end": hi_end},
            "snippet_range": {"start": snippet_start, "end": snippet_end},
            "snippet": render_snippet(lines, snippet_start, snippet_end, hi_start, hi_end),
        }
    )

loc_pattern = re.compile(r"^(.*):(\d+)(?:-(\d+))?$")

for selector in locs_raw:
    m = loc_pattern.match(selector)
    if not m:
        errors.append(f"invalid --loc selector: {selector}")
        continue

    rel_or_abs = m.group(1)
    start_line = int(m.group(2))
    end_line = int(m.group(3) or m.group(2))

    if start_line < 1 or end_line < 1:
        errors.append(f"invalid line number in --loc selector: {selector}")
        continue
    if end_line < start_line:
        errors.append(f"invalid range in --loc selector (end < start): {selector}")
        continue

    abs_file = rel_or_abs if os.path.isabs(rel_or_abs) else os.path.join(root_dir, rel_or_abs)
    if not os.path.exists(abs_file):
        errors.append(f"file not found for --loc selector {selector}: {abs_file}")
        continue

    lines = read_file(abs_file)
    hi_start = start_line
    hi_end = min(end_line, len(lines) if lines else end_line)
    snippet_start = max(1, hi_start - ctx)
    snippet_end = hi_end + ctx

    results.append(
        {
            "selector": f"loc:{selector}",
            "resolved": f"{to_rel(abs_file)}:{hi_start}-{hi_end}",
            "file": to_rel(abs_file),
            "absolute_file": os.path.abspath(abs_file),
            "line": hi_start,
            "range": {"start": hi_start, "end": hi_end},
            "snippet_range": {"start": snippet_start, "end": snippet_end},
            "snippet": render_snippet(lines, snippet_start, snippet_end, hi_start, hi_end),
        }
    )

status = "ok"
if errors and results:
    status = "partial"
elif errors and not results:
    status = "error"

if as_json:
    payload = {
        "status": status,
        "result_count": len(results),
        "query": {
            "entries": entries_raw,
            "locs": locs_raw,
            "context": ctx,
        },
        "results": results,
        "errors": errors,
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2))
else:
    for item in results:
        print(f"{item['resolved']} [{item['file']}] @L{item['line']}")
        print(item["snippet"])
        print("---")
    for err in errors:
        print(f"ERROR: {err}", file=sys.stderr)

if errors:
    sys.exit(1)
sys.exit(0)
PY
}

run_doctor() {
  local as_json="${1:-0}"
  "${PYTHON_BIN}" - "${ROOT_DIR}" "${SIG_FILE}" "${GENERATOR}" "${as_json}" <<'PY'
import json
import os
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
sig_file = Path(sys.argv[2])
generator = Path(sys.argv[3])
as_json = sys.argv[4] == "1"

checks = []


def add(name: str, status: str, detail: str, path: str = "") -> None:
    checks.append({"name": name, "status": status, "detail": detail, "path": path})


if generator.exists() and os.access(generator, os.X_OK):
    add("generator", "ok", "generator executable found", str(generator))
else:
    add("generator", "error", "generator missing or not executable", str(generator))

if sig_file.exists():
    try:
        data = json.loads(sig_file.read_text(encoding="utf-8"))
        if isinstance(data, list):
            add("map_json", "ok", f"valid map JSON ({len(data)} entries)", str(sig_file))
            required = ("path", "signature", "comment", "line")
            bad = []
            missing_kind = 0
            for idx, item in enumerate(data):
                if not isinstance(item, dict):
                    bad.append(f"entry[{idx}] is not an object")
                    continue
                miss = [k for k in required if k not in item]
                if miss:
                    bad.append(f"entry[{idx}] missing fields: {', '.join(miss)}")
                if "kind" not in item:
                    missing_kind += 1
            if bad:
                add("map_schema", "error", f"invalid entry schema; first issue: {bad[0]}", str(sig_file))
            else:
                add("map_schema", "ok", "required fields present (path, signature, comment, line)", str(sig_file))
            if data:
                if missing_kind > 0:
                    add(
                        "map_format",
                        "warn",
                        f"outdated map format detected: {missing_kind}/{len(data)} entries missing kind; run refresh",
                        str(sig_file),
                    )
                else:
                    add("map_format", "ok", "kind field present for all entries", str(sig_file))
            else:
                add("map_format", "ok", "map is empty; format checks deferred until first indexed entry", str(sig_file))
        else:
            add("map_json", "error", "map JSON root is not an array", str(sig_file))
    except Exception as exc:
        add("map_json", "error", f"invalid map JSON: {exc}", str(sig_file))
else:
    add("map_json", "warn", "map file does not exist (run refresh)", str(sig_file))

local_ag = root / "AGENTS.md"
root_skill = root / "SKILL.md"
codex_local_skill = root / ".codex" / "skills" / "signature-map" / "SKILL.md"
agents_local_skill = root / ".agents" / "skills" / "signature-map" / "SKILL.md"
claude_local_skill = root / ".claude" / "skills" / "signature-map" / "SKILL.md"
local_pattern = re.compile(r"(^|\s)(?:\./)?scripts/sigmap\b", re.M)
global_pattern = re.compile(
    r"(?:\$\{?(?:CLAUDE_)?PLUGIN_ROOT\}?|\$\{?CODEX_HOME\}?|\$\{?CLAUDE_HOME\}?|~?/\.codex|~?/\.agents|~?/\.claude|/.+/\.codex|/.+/\.agents|/.+/\.claude)(?:/plugins/signature-map)?/skills/signature-map/scripts/sigmap"
)

local_style_seen = False
global_style_seen = False
for candidate in (local_ag, root_skill, codex_local_skill, agents_local_skill, claude_local_skill):
    if not candidate.exists():
        continue
    txt = candidate.read_text(encoding="utf-8", errors="ignore")
    has_local = bool(local_pattern.search(txt))
    has_global = bool(global_pattern.search(txt))
    local_style_seen = local_style_seen or has_local
    global_style_seen = global_style_seen or has_global
    if has_local and has_global:
        add("instruction_conflict", "warn", "both local and global sigmap commands detected", str(candidate))
    elif has_local:
        add("instruction_style", "ok", "local scripts/sigmap command pattern", str(candidate))
    elif has_global:
        add("instruction_style", "ok", "plugin-root/global sigmap command pattern", str(candidate))

local_sigmap = root / "scripts" / "sigmap"
if local_sigmap.exists():
    if global_style_seen and not local_style_seen:
        add("local_cli", "warn", "local scripts/sigmap exists while docs prefer global path; ensure this is intentional", str(local_sigmap))
    else:
        add("local_cli", "ok", "local scripts/sigmap exists", str(local_sigmap))

errors = [c for c in checks if c["status"] == "error"]
warnings = [c for c in checks if c["status"] == "warn"]
summary = {
    "status": "error" if errors else ("warn" if warnings else "ok"),
    "errors": len(errors),
    "warnings": len(warnings),
    "checks": checks,
}

if as_json:
    print(json.dumps(summary, ensure_ascii=False, indent=2))
else:
    print(f"doctor: {summary['status']} (errors={summary['errors']} warnings={summary['warnings']})")
    for c in checks:
        prefix = c["status"].upper()
        p = f" [{c['path']}]" if c.get("path") else ""
        print(f"- {prefix}: {c['name']} - {c['detail']}{p}")

if errors:
    sys.exit(3)
sys.exit(0)
PY
}

parse_common_options() {
  :
}

cmd="${1:-}"
shift || true

case "${cmd}" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;
  refresh|ensure)
    root_override=""
    map_override=""
    generator_override=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --root)
          [[ $# -lt 2 ]] && die_usage "--root requires a value"
          root_override="$2"
          shift 2
          ;;
        --map|--sig-file)
          [[ $# -lt 2 ]] && die_usage "--map requires a value"
          map_override="$2"
          shift 2
          ;;
        --generator)
          [[ $# -lt 2 ]] && die_usage "--generator requires a value"
          generator_override="$2"
          shift 2
          ;;
        *)
          die_usage "unknown argument: $1"
          ;;
      esac
    done

    resolve_context "${root_override}" "${map_override}" "${generator_override}"
    refresh_map
    echo "OK: refreshed ${SIG_FILE}"
    ;;
  name)
    if [[ $# -lt 1 ]]; then
      die_usage "name requires <Symbol>"
    fi

    symbol="$1"
    shift

    kind_filter="any"
    file_prefixes=()
    limit="20"
    as_json="0"
    strict_empty="0"
    no_refresh="0"
    root_override=""
    map_override=""
    generator_override=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --kind)
          [[ $# -lt 2 ]] && die_usage "--kind requires a value"
          kind_filter="$2"
          shift 2
          ;;
        --file)
          [[ $# -lt 2 ]] && die_usage "--file requires a value"
          file_prefixes+=("$2")
          shift 2
          ;;
        --limit)
          [[ $# -lt 2 ]] && die_usage "--limit requires a value"
          limit="$2"
          shift 2
          ;;
        --json)
          as_json="1"
          shift
          ;;
        --strict-empty)
          strict_empty="1"
          shift
          ;;
        --no-refresh)
          no_refresh="1"
          shift
          ;;
        --root)
          [[ $# -lt 2 ]] && die_usage "--root requires a value"
          root_override="$2"
          shift 2
          ;;
        --map|--sig-file)
          [[ $# -lt 2 ]] && die_usage "--map requires a value"
          map_override="$2"
          shift 2
          ;;
        --generator)
          [[ $# -lt 2 ]] && die_usage "--generator requires a value"
          generator_override="$2"
          shift 2
          ;;
        *)
          die_usage "unknown argument: $1"
          ;;
      esac
    done

    case "${kind_filter}" in
      any|type|callable) ;;
      *) die_usage "--kind must be one of: any, type, callable" ;;
    esac

    resolve_context "${root_override}" "${map_override}" "${generator_override}"
    prepare_map "${no_refresh}"
    FILE_PREFIXES="$(nl_join "${file_prefixes[@]}")" KIND_FILTER="${kind_filter}" LIMIT="${limit}" AS_JSON="${as_json}" STRICT_EMPTY="${strict_empty}" run_query name "${symbol}"
    ;;
  search)
    if [[ $# -lt 1 ]]; then
      die_usage "search requires <regex>"
    fi

    pattern="$1"
    shift

    field="all"
    kind_filter="any"
    file_prefixes=()
    limit="20"
    icase="0"
    as_json="0"
    strict_empty="0"
    no_refresh="0"
    root_override=""
    map_override=""
    generator_override=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --field)
          [[ $# -lt 2 ]] && die_usage "--field requires a value"
          field="$2"
          shift 2
          ;;
        --kind)
          [[ $# -lt 2 ]] && die_usage "--kind requires a value"
          kind_filter="$2"
          shift 2
          ;;
        --file)
          [[ $# -lt 2 ]] && die_usage "--file requires a value"
          file_prefixes+=("$2")
          shift 2
          ;;
        --limit)
          [[ $# -lt 2 ]] && die_usage "--limit requires a value"
          limit="$2"
          shift 2
          ;;
        --icase)
          icase="1"
          shift
          ;;
        --json)
          as_json="1"
          shift
          ;;
        --strict-empty)
          strict_empty="1"
          shift
          ;;
        --no-refresh)
          no_refresh="1"
          shift
          ;;
        --root)
          [[ $# -lt 2 ]] && die_usage "--root requires a value"
          root_override="$2"
          shift 2
          ;;
        --map|--sig-file)
          [[ $# -lt 2 ]] && die_usage "--map requires a value"
          map_override="$2"
          shift 2
          ;;
        --generator)
          [[ $# -lt 2 ]] && die_usage "--generator requires a value"
          generator_override="$2"
          shift 2
          ;;
        *)
          die_usage "unknown argument: $1"
          ;;
      esac
    done

    case "${field}" in
      path|signature|comment|all) ;;
      *) die_usage "--field must be one of: path, signature, comment, all" ;;
    esac
    case "${kind_filter}" in
      any|type|callable) ;;
      *) die_usage "--kind must be one of: any, type, callable" ;;
    esac

    resolve_context "${root_override}" "${map_override}" "${generator_override}"
    prepare_map "${no_refresh}"
    FIELD="${field}" FILE_PREFIXES="$(nl_join "${file_prefixes[@]}")" KIND_FILTER="${kind_filter}" LIMIT="${limit}" ICASE="${icase}" AS_JSON="${as_json}" STRICT_EMPTY="${strict_empty}" run_query search "${pattern}"
    ;;
  show)
    if [[ $# -lt 1 ]]; then
      die_usage "show requires <path::symbol>"
    fi

    key="$1"
    shift

    as_json="0"
    strict_empty="0"
    no_refresh="0"
    root_override=""
    map_override=""
    generator_override=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --json)
          as_json="1"
          shift
          ;;
        --strict-empty)
          strict_empty="1"
          shift
          ;;
        --no-refresh)
          no_refresh="1"
          shift
          ;;
        --root)
          [[ $# -lt 2 ]] && die_usage "--root requires a value"
          root_override="$2"
          shift 2
          ;;
        --map|--sig-file)
          [[ $# -lt 2 ]] && die_usage "--map requires a value"
          map_override="$2"
          shift 2
          ;;
        --generator)
          [[ $# -lt 2 ]] && die_usage "--generator requires a value"
          generator_override="$2"
          shift 2
          ;;
        *)
          die_usage "unknown argument: $1"
          ;;
      esac
    done

    resolve_context "${root_override}" "${map_override}" "${generator_override}"
    prepare_map "${no_refresh}"
    LIMIT="0" KIND_FILTER="any" AS_JSON="${as_json}" STRICT_EMPTY="${strict_empty}" run_query show "${key}"
    ;;
  open)
    entries=()
    locs=()
    ctx="40"
    as_json="0"
    no_refresh="0"
    root_override=""
    map_override=""
    generator_override=""

    if [[ $# -gt 0 && "$1" != --* ]]; then
      entries+=("$1")
      shift
    fi

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --entry)
          [[ $# -lt 2 ]] && die_usage "--entry requires a value"
          entries+=("$2")
          shift 2
          ;;
        --loc)
          [[ $# -lt 2 ]] && die_usage "--loc requires a value"
          locs+=("$2")
          shift 2
          ;;
        --context)
          [[ $# -lt 2 ]] && die_usage "--context requires a value"
          ctx="$2"
          shift 2
          ;;
        --json)
          as_json="1"
          shift
          ;;
        --no-refresh)
          no_refresh="1"
          shift
          ;;
        --root)
          [[ $# -lt 2 ]] && die_usage "--root requires a value"
          root_override="$2"
          shift 2
          ;;
        --map|--sig-file)
          [[ $# -lt 2 ]] && die_usage "--map requires a value"
          map_override="$2"
          shift 2
          ;;
        --generator)
          [[ $# -lt 2 ]] && die_usage "--generator requires a value"
          generator_override="$2"
          shift 2
          ;;
        *)
          die_usage "unknown argument: $1"
          ;;
      esac
    done

    if [[ ${#entries[@]} -eq 0 && ${#locs[@]} -eq 0 ]]; then
      die_usage "open requires at least one selector (positional <path::symbol>, --entry, or --loc)"
    fi

    if [[ "${ctx}" =~ ^[0-9]+$ ]] && (( ctx > 120 )); then
      echo "WARNING: context ${ctx} is large and may add unnecessary tokens" >&2
    fi

    resolve_context "${root_override}" "${map_override}" "${generator_override}"
    prepare_map "${no_refresh}"
    ENTRIES="$(nl_join "${entries[@]}")" LOCS="$(nl_join "${locs[@]}")" CTX="${ctx}" AS_JSON="${as_json}" run_open
    ;;
  batch-open)
    entries=()
    locs=()
    entries_files=()
    ctx="40"
    as_json="0"
    no_refresh="0"
    root_override=""
    map_override=""
    generator_override=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --entry)
          [[ $# -lt 2 ]] && die_usage "--entry requires a value"
          entries+=("$2")
          shift 2
          ;;
        --entries-file)
          [[ $# -lt 2 ]] && die_usage "--entries-file requires a value"
          entries_files+=("$2")
          shift 2
          ;;
        --loc)
          [[ $# -lt 2 ]] && die_usage "--loc requires a value"
          locs+=("$2")
          shift 2
          ;;
        --context)
          [[ $# -lt 2 ]] && die_usage "--context requires a value"
          ctx="$2"
          shift 2
          ;;
        --json)
          as_json="1"
          shift
          ;;
        --no-refresh)
          no_refresh="1"
          shift
          ;;
        --root)
          [[ $# -lt 2 ]] && die_usage "--root requires a value"
          root_override="$2"
          shift 2
          ;;
        --map|--sig-file)
          [[ $# -lt 2 ]] && die_usage "--map requires a value"
          map_override="$2"
          shift 2
          ;;
        --generator)
          [[ $# -lt 2 ]] && die_usage "--generator requires a value"
          generator_override="$2"
          shift 2
          ;;
        *)
          die_usage "unknown argument: $1"
          ;;
      esac
    done

    for entries_file in "${entries_files[@]}"; do
      if [[ ! -f "${entries_file}" ]]; then
        die_usage "entries file not found: ${entries_file}"
      fi
      while IFS= read -r raw_line || [[ -n "${raw_line}" ]]; do
        line="${raw_line#"${raw_line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        if [[ -z "${line}" ]]; then
          continue
        fi
        if [[ "${line:0:1}" == "#" ]]; then
          continue
        fi
        if [[ "${line}" == *"::"* ]]; then
          entries+=("${line}")
        elif [[ "${line}" =~ :[0-9]+(-[0-9]+)?$ ]]; then
          locs+=("${line}")
        else
          die_usage "unsupported selector in ${entries_file}: ${line}"
        fi
      done < "${entries_file}"
    done

    if [[ ${#entries[@]} -eq 0 && ${#locs[@]} -eq 0 ]]; then
      die_usage "batch-open requires at least one selector (--entry, --entries-file, or --loc)"
    fi

    if [[ "${ctx}" =~ ^[0-9]+$ ]] && (( ctx > 120 )); then
      echo "WARNING: context ${ctx} is large and may add unnecessary tokens" >&2
    fi

    resolve_context "${root_override}" "${map_override}" "${generator_override}"
    prepare_map "${no_refresh}"
    ENTRIES="$(nl_join "${entries[@]}")" LOCS="$(nl_join "${locs[@]}")" CTX="${ctx}" AS_JSON="${as_json}" run_open
    ;;
  doctor)
    root_override=""
    map_override=""
    generator_override=""
    as_json="0"

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --root)
          [[ $# -lt 2 ]] && die_usage "--root requires a value"
          root_override="$2"
          shift 2
          ;;
        --map|--sig-file)
          [[ $# -lt 2 ]] && die_usage "--map requires a value"
          map_override="$2"
          shift 2
          ;;
        --generator)
          [[ $# -lt 2 ]] && die_usage "--generator requires a value"
          generator_override="$2"
          shift 2
          ;;
        --json)
          as_json="1"
          shift
          ;;
        *)
          die_usage "unknown argument: $1"
          ;;
      esac
    done

    resolve_context "${root_override}" "${map_override}" "${generator_override}"
    run_doctor "${as_json}"
    ;;
  *)
    die_usage "unknown command: ${cmd}"
    ;;
esac
